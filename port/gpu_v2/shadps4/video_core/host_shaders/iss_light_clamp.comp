// Diagnostics (ISS_LIGHT_ZERO threshold specs, vk_rasterizer.cpp): in an array of light records,
// zero a range of every record whose three floats at `match` include one above `threshold`.
#version 450
layout(local_size_x = 64) in;

layout(std430, set = 0, binding = 0) buffer Data { uint d[]; };

layout(push_constant) uniform Params {
    uint base;   // first record, in dwords from the bound offset
    uint stride; // record stride, dwords
    uint count;  // records
    uint match;  // dword offset of the three floats tested
    float threshold;
    uint zero;   // dword offset of the range zeroed
    uint zero_n; // dwords zeroed
} p;

void main() {
    const uint i = gl_GlobalInvocationID.x;
    if (i >= p.count) return;
    const uint r = p.base + i * p.stride;
    bool hit = false;
    for (uint c = 0; c < 3; ++c) hit = hit || uintBitsToFloat(d[r + p.match + c]) > p.threshold;
    if (!hit) return;
    for (uint k = 0; k < p.zero_n; ++k) d[r + p.zero + k] = 0u;
}
